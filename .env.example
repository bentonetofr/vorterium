# Supabase
# Obtenha esses valores em: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Transmissão de tela da Mesa (opcional)
# Sem isso a conexão usa só STUN público, que resolve a maioria das redes.
# Para redes mais fechadas (4G, empresa, faculdade), configure um servidor TURN:
# VITE_TURN_URLS=turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
